# ==============================================================================
# ThermoCell-AI Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment: 'development' | 'production'
ENVIRONMENT=development

# Database Connection URL:
# Development default: SQLite local file (sqlite:///data/thermocell_sessions.db)
# Production requirement: PostgreSQL connection string
# Example: postgresql://thermocell_user:your_secure_password@localhost:5432/thermocell_prod
DATABASE_URL=sqlite:///data/thermocell_sessions.db

# Allowed CORS Origins (comma-separated list):
# In production, specify exact domain(s) without wildcards or trailing slashes.
# Example: https://dashboard.thermocell.ai,https://bench.thermocell.ai
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT Cryptographic Signing Key:
# MANDATORY in production: Must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production-32chars

# JWT Algorithm and Lifetime:
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Operator Dashboard Authentication:
OPERATOR_USERNAME=operator
# Bcrypt hash of operator password. In production, generate a unique bcrypt hash.
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
OPERATOR_PASSWORD_HASH=$2b$12$MgCbPkQERq6WmkkPOOsTP.kiev9aB69Dz/B4HKfp4AyNcSvwi6Lla

# Hardware Telemetry Ingestion API Key:
# Used by ESP32 microcontrollers and hardware/serial_bridge.py via X-API-Key header.
# In production, must be at least 16 characters.
HARDWARE_API_KEY=dev-hw-key-18650

# Operational Controls:
# Set to 'false' to disable OpenAPI docs (/docs, /redoc) in production.
DOCS_ENABLED=true

# Rate Limiting & Abuse Protection:
RATE_LIMIT_ENABLED=true

# Maximum Request Body Payload Size in Bytes (Default: 1048576 = 1MB):
MAX_PAYLOAD_BYTES=1048576
